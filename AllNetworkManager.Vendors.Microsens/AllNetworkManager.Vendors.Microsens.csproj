<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AllNetworkManager.Core\AllNetworkManager.Core.csproj" />
    <ProjectReference Include="..\AllNetworkManager.Discovery\AllNetworkManager.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CryptSharpOfficial" Version="2.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CryptSharpOfficial ships only .NET Framework assets but its crypto is pure managed code;
         outputs are verified byte-for-byte against the vendor tool's own hashes. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
