<Window x:Class="AllNetworkManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AllNetworkManager.App.ViewModels"
        xmlns:v="clr-namespace:AllNetworkManager.App.Views"
        mc:Ignorable="d"
        Title="AllNetworkManager - Network Device Manager" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:ManufacturerToIconConverter x:Key="ManufacturerToIcon"/>
        <vm:StatusToBrushConverter x:Key="StatusToBrush"/>
        <vm:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="AllNetworkManager" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Network Device Manager" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" Margin="16,0" MinWidth="0" MaxWidth="400" HorizontalAlignment="Stretch">
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8,12,8"
                                 VerticalAlignment="Center"
                                 FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="20"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Margin="{TemplateBinding Padding}"
                                                                          VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="Watermark"
                                                                       Text="Search devices..."
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Margin="16,0,4,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsHitTestVisible="False"
                                                                       FontSize="13"
                                                                       Visibility="Collapsed"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="🔍" FontSize="15"
                                                                   VerticalAlignment="Center" Margin="6,0,14,0"
                                                                   IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="Online only" 
                              IsChecked="{Binding ShowOnlyOnline}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Foreground="{StaticResource TextSecondaryBrush}"/>

                    <Button Command="{Binding DiscoverCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsDiscovering, Converter={StaticResource InverseBool}}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,6,0"/>
                            <TextBlock Text="Discover"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopDiscoveryCommand}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding IsDiscovering}"
                            Padding="16,8"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹" Margin="0,0,6,0"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource FlatButton}"
                            Padding="12,8"
                            Margin="8,0,0,0"
                            ToolTip="Export inventare do CSV">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>

                    <CheckBox Content="Auto-rescan"
                              IsChecked="{Binding AutoRescan}"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <ProgressBar DockPanel.Dock="Top"
                     Height="4"
                     Value="{Binding DiscoveryProgress}"
                     Maximum="1"
                     IsIndeterminate="{Binding IsDiscovering}"
                     Style="{StaticResource ModernProgressBar}"
                     Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVis}}"/>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding DiscoveryStatus}" Foreground="{StaticResource TextSecondaryBrush}"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding Devices.Count, StringFormat='{}{0} devices'}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               ToolTip="{Binding StorePath}"/>
                    <TextBlock Text="  •  " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding RescanIntervalSeconds, StringFormat='rescan {0}s'}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding RefreshSubnetsCommand}"
                                        Style="{StaticResource FlatButton}"
                                        Padding="6,1"
                                        FontSize="13"
                                        ToolTip="Obnovit seznam síťových rozhraní"
                                        Content="↻"/>
                                <TextBlock Text="Discovered Devices" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Which network range to scan -->
                            <ComboBox ItemsSource="{Binding Subnets}"
                                      SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      Margin="0,8,0,0"
                                      ToolTip="Vyber síťovou kartu, jejíž rozsah se má prohledat"/>

                            <DockPanel Margin="0,6,0,0"
                                       Visibility="{Binding IsCustomTarget, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ScanTargetCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,6"
                                        Margin="6,0,0,0"
                                        Content="Prohledat"/>
                                <TextBox Text="{Binding CustomRange, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Např. 192.168.0.10-192.168.0.60, 192.168.0.10-60 nebo 10.0.0.0/24"/>
                            </DockPanel>

                            <TextBlock Text="např. 192.168.0.10-192.168.0.60 nebo 10.0.0.0/24"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="2,4,0,0"
                                       Visibility="{Binding IsCustomTarget, Converter={StaticResource BoolToVis}}"/>

                            <CheckBox Content="Projít každou adresu (důkladné)"
                                      IsChecked="{Binding DeepScan}"
                                      Margin="0,6,0,0"
                                      ToolTip="Kromě multicast discovery projde každou adresu rozsahu na běžných portech. Najde i zařízení, která se multicastem nehlásí."
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Visibility="{Binding ShowsScanOptions, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="DeviceList"
                              ItemsSource="{Binding FilteredDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              SizeChanged="DeviceList_SizeChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Device" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <TextBlock Text="{Binding Manufacturer, Converter={StaticResource ManufacturerToIcon}}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="📝" FontSize="11" Margin="6,0,0,0"
                                                                   ToolTip="{Binding NotesTooltip}"
                                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Margin="4,0" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="8,6"/>
                                <EventSetter Event="MouseDoubleClick" Handler="DeviceItem_DoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext"/>

            <!-- Device Details -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                <ContentControl Content="{Binding SelectedDevice}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                            <v:DeviceDetailView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>